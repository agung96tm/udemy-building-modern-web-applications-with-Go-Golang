{{ template "base" . }}

{{ define "content" }}
    <div class="container">
        <div class="row">
            <div class="col">
                <h1>About</h1>

                <p>Test Var: {{ index .StringMap "test" }}</p>
                <p>Your IP:
                    {{ if ne (index .StringMap "remote_ip") ""}}
                        {{ index .StringMap "remote_ip" }}
                        {{ else }}
                        I dont know yet, please to home page :)
                            {{ end }}
                </p>
                <p>
                    Your Name: {{ index .StringMap "name" }}
                </p>
            </div>
        </div>
    </div>
{{ end }}